<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>NoType</string>
	<key>CFBundleDisplayName</key>
	<string>NoType</string>
	<!-- Space-free so `pkill -x NoType` matches exactly this app and nothing else. -->
	<key>CFBundleExecutable</key>
	<string>NoType</string>
	<!-- TCC keys Accessibility and Microphone grants to this ID. -->
	<key>CFBundleIdentifier</key>
	<string>com.notype.app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- notype://show raises the comparison window, for scripting. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.notype.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>notype</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A menu bar app: no Dock icon, so none flashes at launch. Settings ▸ Show in Dock
	     switches to a regular app at runtime for anyone who wants one. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>NoType listens while you hold the push-to-talk key so it can turn your speech into text.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NoType transcribes your speech on-device to insert text where you're typing.</string>
</dict>
</plist>
